# Backend API URL (Production Render deployment)
VITE_API_BASE_URL=https://computer-vision-and-visual-intelligence.onrender.com

# Supabase — browser client (Vite exposes VITE_ prefixed vars)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Gemini — only needed if running backend locally via Vite proxy
# (not needed if you deploy the backend separately)
GEMINI_API_KEY=your_gemini_api_key_here
